<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="its-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.example.its.persistence.entity.Account</class>
        <class>com.example.its.persistence.entity.Project</class>
        <class>com.example.its.persistence.entity.Issue</class>
        <class>com.example.its.persistence.entity.Comment</class>
        <class>com.example.its.persistence.entity.Tag</class>
        <class>com.example.its.persistence.entity.ProjectMember</class>
        <class>com.example.its.persistence.entity.IssueHistory</class>
        <class>com.example.its.persistence.entity.IssueDelta</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:database/its.db?journal_mode=WAL&amp;busy_timeout=5000"/>
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
