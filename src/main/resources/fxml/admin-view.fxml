<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.its.ui.javafx.controller.AdminController"
            styleClass="admin-shell">
    <padding>
        <Insets top="0" right="0" bottom="0" left="0"/>
    </padding>

    <center>
        <VBox spacing="18" styleClass="admin-content">
            <padding>
                <Insets top="22" right="26" bottom="24" left="26"/>
            </padding>

            <VBox spacing="6">
                <Label fx:id="adminPageTitleLabel" text="Add User" styleClass="page-title"/>
                <Label fx:id="permissionNoticeLabel" text="" wrapText="true" styleClass="admin-warning-label"/>
            </VBox>

            <TabPane fx:id="adminTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="admin-tab-pane">
                <tabs>
                    <Tab text="Add User">
                        <content>
                            <HBox spacing="20" alignment="TOP_LEFT">
                                <VBox spacing="16" styleClass="admin-form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets top="20" right="24" bottom="20" left="24"/>
                                    </padding>

                                    <GridPane hgap="14" vgap="14">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="130" prefWidth="150"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Login name:" styleClass="admin-form-label"/>
                                        <TextField fx:id="loginIdField" promptText="Enter login ID" GridPane.columnIndex="1" styleClass="admin-input emphasized-input"/>

                                        <Label text="Real name:" GridPane.rowIndex="1" styleClass="admin-form-label"/>
                                        <TextField fx:id="realNameField" promptText="Enter user's full name" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="admin-input"/>

                                        <Label text="Email:" GridPane.rowIndex="2" styleClass="admin-form-label"/>
                                        <TextField fx:id="emailField" promptText="user@its.local" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="admin-input"/>

                                        <Label text="Password:" GridPane.rowIndex="3" styleClass="admin-form-label"/>
                                        <PasswordField fx:id="passwordField" promptText="Set initial password" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="admin-input"/>

                                        <Label text="Role:" GridPane.rowIndex="4" styleClass="admin-form-label"/>
                                        <ComboBox fx:id="roleCombo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="admin-input"/>
                                    </GridPane>
                                    <Label fx:id="formFeedbackLabel" text="" wrapText="true" styleClass="form-feedback"/>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Button mnemonicParsing="false" onAction="#handleAddUser" text="Add User" styleClass="primary-button"/>
                                        <Button mnemonicParsing="false" onAction="#clearForm" text="Reset" styleClass="ghost-button"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="14" styleClass="admin-side-card">
                                    <padding>
                                        <Insets top="20" right="20" bottom="20" left="20"/>
                                    </padding>
                                    <Label text="Existing Users" styleClass="section-title"/>
                                    <TableView fx:id="userTable" prefWidth="520" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                                            <TableColumn fx:id="loginIdColumn" text="Login" prefWidth="90"/>
                                            <TableColumn fx:id="realNameColumn" text="Real Name" prefWidth="120"/>
                                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="145"/>
                                            <TableColumn fx:id="roleColumn" text="Role" prefWidth="65"/>
                                            <TableColumn fx:id="activeColumn" text="Status" prefWidth="90"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </HBox>
                        </content>
                    </Tab>

                    <Tab text="Add Project">
                        <content>
                            <HBox spacing="20" alignment="TOP_LEFT">
                                <VBox spacing="16" styleClass="admin-form-card" HBox.hgrow="ALWAYS">
                                    <padding>
                                        <Insets top="20" right="24" bottom="20" left="24"/>
                                    </padding>

                                    <GridPane hgap="14" vgap="14">
                                        <columnConstraints>
                                            <ColumnConstraints minWidth="150" prefWidth="170"/>
                                            <ColumnConstraints hgrow="ALWAYS"/>
                                        </columnConstraints>

                                        <Label text="Project:" styleClass="admin-form-label"/>
                                        <TextField fx:id="projectNameField" promptText="Enter project name" GridPane.columnIndex="1" styleClass="admin-input emphasized-input"/>

                                        <Label text="Description:" GridPane.rowIndex="1" styleClass="admin-form-label"/>
                                        <TextArea fx:id="projectDescriptionArea" wrapText="true" prefRowCount="3" promptText="Describe the project's purpose and scope." GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="admin-text-area"/>

                                        <Label text="Version:" GridPane.rowIndex="2" styleClass="admin-form-label"/>
                                        <TextField fx:id="versionField" promptText="1.0.0" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="admin-input short-input"/>

                                        <Label text="Project tags:" GridPane.rowIndex="3" styleClass="admin-form-label"/>
                                        <VBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                            <TextField fx:id="tagNameField" promptText="Tag name (e.g. auth, ui, workflow)" styleClass="admin-input"/>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Button mnemonicParsing="false" onAction="#handleAddProjectTag" text="Add Tag" styleClass="ghost-button"/>
                                                <Button mnemonicParsing="false" onAction="#handleRemoveSelectedProjectTag" text="Remove Selected" styleClass="ghost-button"/>
                                            </HBox>
                                            <ListView fx:id="projectTagListView" prefHeight="120"/>
                                        </VBox>
                                    </GridPane>
                                    <Label fx:id="projectFormFeedbackLabel" text="" wrapText="true" styleClass="form-feedback"/>

                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Button mnemonicParsing="false" onAction="#handleAddProject" text="Add Project" styleClass="primary-button"/>
                                        <Button mnemonicParsing="false" onAction="#clearProjectForm" text="Reset" styleClass="ghost-button"/>
                                    </HBox>
                                </VBox>

                                <VBox spacing="14" styleClass="admin-side-card">
                                    <padding>
                                        <Insets top="20" right="20" bottom="20" left="20"/>
                                    </padding>
                                    <Label text="Existing Projects" styleClass="section-title"/>
                                    <TableView fx:id="projectTable" prefWidth="520" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="projectIdColumn" text="ID" prefWidth="55"/>
                                            <TableColumn fx:id="projectNameColumn" text="Project" prefWidth="120"/>
                                            <TableColumn fx:id="versionColumn" text="Version" prefWidth="75"/>
                                            <TableColumn fx:id="entryColumn" text="Entry" prefWidth="75"/>
                                            <TableColumn fx:id="tagColumn" text="Tags" prefWidth="120"/>
                                            <TableColumn fx:id="assigneeColumn" text="Created By" prefWidth="105"/>
                                        </columns>
                                    </TableView>
                                </VBox>
                            </HBox>
                        </content>
                    </Tab>
                </tabs>
            </TabPane>
        </VBox>
    </center>
</BorderPane>
