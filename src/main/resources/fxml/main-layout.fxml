<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.its.ui.javafx.controller.MainLayoutController"
            prefWidth="1280" prefHeight="780" styleClass="app-shell">
    <top>
        <HBox spacing="16" styleClass="top-bar">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>
            <Label text="ITS" styleClass="brand-mark"/>
            <Label text="Issue Tracking System" styleClass="brand-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Project:" styleClass="meta-label"/>
            <Label fx:id="currentProjectLabel" styleClass="meta-value"/>
            <Separator orientation="VERTICAL"/>
            <Label text="Current User:" styleClass="meta-label"/>
            <Label fx:id="currentUserLabel" styleClass="meta-value"/>
            <Label fx:id="currentRoleLabel" styleClass="role-pill"/>
            <Button mnemonicParsing="false" onAction="#handleLogout" text="Log Out" styleClass="topbar-button"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="8" styleClass="sidebar">
            <padding>
                <Insets top="20" right="14" bottom="20" left="14"/>
            </padding>
            <Label text="Navigation" styleClass="sidebar-title"/>
            <Button fx:id="homeNavButton" mnemonicParsing="false" onAction="#showHome" text="Home" styleClass="nav-button active"/>
            <Button fx:id="issuesNavButton" mnemonicParsing="false" onAction="#showIssues" text="Issues" styleClass="nav-button"/>
            <Button fx:id="searchNavButton" mnemonicParsing="false" onAction="#showSearch" text="Search" styleClass="nav-button"/>
            <Button fx:id="inquiryNavButton" mnemonicParsing="false" onAction="#showInquiry" text="Inquiry" styleClass="nav-button"/>
            <Button fx:id="createIssueNavButton" mnemonicParsing="false" onAction="#showCreateIssue" text="Create Issue" styleClass="nav-button"/>
            <Button fx:id="analyticsNavButton" mnemonicParsing="false" onAction="#showAnalytics" text="Analytics" styleClass="nav-button"/>
            <Button fx:id="adminNavButton" mnemonicParsing="false" onAction="#showAdmin" text="Admin" styleClass="nav-button"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentContainer"/>
    </center>
</BorderPane>
