<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.its.ui.javafx.controller.InquiryController"
      spacing="18" styleClass="content-container inquiry-shell">
    <padding>
        <Insets top="16" right="18" bottom="18" left="18"/>
    </padding>

    <VBox spacing="6">
        <Label text="Inquiry" styleClass="page-title"/>
        <Label text="Look up a specific issue by ID or keyword, then open a dedicated Inquiry Results window." styleClass="landing-copy"/>
    </VBox>

    <VBox spacing="14" styleClass="panel-card inquiry-toolbar-card" maxWidth="920">
        <Label text="Inquiry Builder" styleClass="section-title"/>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="inquiry-search-shell">
            <TextField fx:id="issueIdField" promptText="Issue ID" prefWidth="150" styleClass="inquiry-search-field"/>
            <TextField fx:id="keywordField" promptText="Title or keyword" HBox.hgrow="ALWAYS" styleClass="inquiry-search-field"/>
            <Button mnemonicParsing="false" onAction="#handleInquire" text="Open Results" styleClass="primary-button inquiry-toolbar-button"/>
            <Button mnemonicParsing="false" onAction="#showRecentIssues" text="Recent Issues" styleClass="ghost-button inquiry-toolbar-button"/>
        </HBox>
        <Label fx:id="inquirySummaryLabel" text="Use an exact ID or keyword, then open a dedicated Inquiry Results window." styleClass="landing-copy"/>
    </VBox>
</VBox>
